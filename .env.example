APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

AUTH_MODEL=App\Models\User

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database`

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=settlers_credi_coop_db
DB_USERNAME=root
DB_PASSWORD=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_CA_BUNDLE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Settlers Credit Cooperative"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===== Backups =====
# Encryption password used for ALL backup archives (local, cloud and downloads).
# REQUIRED whenever backup encryption is enabled. Keep it secret; a lost key
# means backups can no longer be decrypted.
BACKUP_ARCHIVE_PASSWORD=
# Email addresses (comma separated) notified by the backup engine on failures.
BACKUP_NOTIFICATION_EMAIL=
# Secret token used by the shared-hosting cron fallback endpoint (/backup/ping).
BACKUP_PING_TOKEN=

# ===== Google Drive (cloud backup tier) =====
# Optional: admins can store these from Settings > Backup & Restore instead
# (encrypted in the app_credentials table). These .env values act as a fallback.
# See docs/BACKUPS.md for how to create these via a Google Cloud project.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER=
# GOOGLE_DRIVE_TEAM_DRIVE_ID=

VITE_APP_NAME="${APP_NAME}"

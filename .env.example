# -----------------------------------------------------------------------------
# Settlers Credit Cooperative -- environment template.
#
#   cp .env.example .env
#   php artisan key:generate      fills APP_KEY
#
# Only keys the application actually reads are listed. Everything left blank is
# a secret or is specific to one deployment and has no safe default.
#
# An empty value is not the same as a missing key: env('KEY', 'fallback') only
# falls back when the key is absent, so a bare `KEY=` yields an empty string.
# Comment a key out entirely when it should fall back to its default -- see
# BACKUP_NOTIFICATION_EMAIL below.
# -----------------------------------------------------------------------------

# ===== Application =====
APP_NAME="Settlers Credit Cooperative"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Comma-separated keys still honoured while rotating APP_KEY.
# APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# file = storage/framework/down, database = the maintenance flag in settings.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Hosts Sanctum treats as stateful, so the SPA can hold a session cookie. The
# Vite dev server and the artisan server must both be listed or API calls 401.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080

# Worker processes for `php artisan serve`.
PHP_CLI_SERVER_WORKERS=4

# ===== Authentication =====
AUTH_MODEL=App\Models\User
# Seconds a password may be reused before a reset is forced (3 hours).
AUTH_PASSWORD_TIMEOUT=10800
# Defaults on only when APP_ENV=local. Set false to require new-device login OTP locally.
LOGIN_OTP_BYPASS=

# ===== Database =====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=settlers_credit_coop
DB_USERNAME=
DB_PASSWORD=
# Optional restore drill. Create a disposable MySQL database and grant this
# distinct account privileges on that database only. Never reuse DB_USERNAME.
BACKUP_VERIFY_DB_HOST=127.0.0.1
BACKUP_VERIFY_DB_PORT=3306
BACKUP_VERIFY_DB_DATABASE=
BACKUP_VERIFY_DB_USERNAME=
BACKUP_VERIFY_DB_PASSWORD=
# Directory holding the mysqldump binary. Required on Windows/Laragon for
# database-scope backups; leave unset on Linux/macOS where it is on PATH.
# DB_DUMP_BINARY_PATH=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin

# ===== Cache, queue, session, files =====
CACHE_STORE=database

QUEUE_CONNECTION=database
# Seconds a reserved job may run before it is released. Backups dump the whole
# database, so keep this comfortably above the longest backup.
DB_QUEUE_RETRY_AFTER=7200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local

# ===== Logging =====
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== Mail =====
# log writes notifications to the log instead of sending them; switch to smtp
# for a real deployment.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Bound synchronous mail delivery so OTP requests do not hang during an outage.
MAIL_TIMEOUT=3
# Laravel's SMTP mailer accepts `smtp` or `smtps` as the scheme. For port 587,
# use `smtp` (STARTTLS); for port 465, use `smtps`.
# MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ===== Cloudflare Turnstile =====
# Login, registration and password reset are gated by Turnstile.
# The site key is handed to the browser, the secret key must never leave the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== TextBee SMS =====
# Keep the API key in the server environment, never in source control.
TEXTBEE_API_KEY=
TURNSTILE_CA_BUNDLE=false

# ===== Backups =====
# Encrypts every archive (hourly, daily, off-site and downloads). Required
# whenever archive encryption is on: a lost password means archives can never
# be decrypted again.
BACKUP_ARCHIVE_PASSWORD=
# Addresses (comma separated) notified by the backup engine on failure. Leave
# this commented out rather than blank -- Spatie validates the list while
# building its config, so a present-but-empty value takes down every artisan
# command. It falls back to MAIL_FROM_ADDRESS.
# BACKUP_NOTIFICATION_EMAIL=
# Shared token for the cron fallback endpoint /backup/ping.
BACKUP_PING_TOKEN=
# Grandfather-Father-Son (GFS) retention schedule settings
# BACKUP_GFS_DAILY_DAYS=14
# BACKUP_GFS_WEEKLY_WEEKS=5
# BACKUP_GFS_MONTHLY_MONTHS=12

# ===== Backblaze B2 (off-site backup tier) =====
# The off-site daily backup uploads to a B2 bucket over its S3-compatible
# endpoint. The "b2" disk in config/filesystems.php forces path-style requests,
# because B2 requires them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-005
AWS_BUCKET=
AWS_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# Optional: S3 Object Lock (WORM immutability) when enabled on the B2 bucket
# BACKUP_OFFSITE_OBJECT_LOCK_ENABLED=false
# BACKUP_OFFSITE_OBJECT_LOCK_MODE=GOVERNANCE
# BACKUP_OFFSITE_OBJECT_LOCK_DAYS=30

# ===== Xendit (online payments) =====
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_MODE=test
XENDIT_TEST_SECRET_KEY=
XENDIT_TEST_WEBHOOK_TOKEN=
XENDIT_LIVE_SECRET_KEY=
XENDIT_LIVE_WEBHOOK_TOKEN=

# ===== PSGC (Philippine address selector) =====
PSGC_API_PREFIX=psgc
# Caches the region/province/municipality lookup in the cache store above.
PSGC_CACHE=false
# PSGC_CACHE_STORE=database

# ===== Audit log =====
ACTIVITY_LOGGER_ENABLED=true

# ===== Vite (development only) =====
# Backend the dev server proxies to; must match the artisan server port.
VITE_HMR_HOST=localhost
VITE_BACKEND_URL=http://127.0.0.1:8000
# Leave unset to call the API on the same origin the SPA was served from.
# VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Local development environment template (safe to commit; holds no credentials).
# Copy to .env, then run: php artisan key:generate
# -----------------------------------------------------------------------------
# ===== Application =====
APP_NAME="Settlers Credit Cooperative"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080

PHP_CLI_SERVER_WORKERS=4

# ===== Authentication =====
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_TIMEOUT=10800

# ===== Database =====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=settlers_credi_coop_db
DB_USERNAME=root
DB_PASSWORD=
# Directory holding the mysqldump binary. Required on Windows/Laragon for
# database-scope backups; leave unset on Linux/macOS where it is on PATH.
DB_DUMP_BINARY_PATH=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin

# ===== Cache, queue, session, files =====
CACHE_STORE=database

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=7200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local

# ===== Logging =====
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== Mail =====
# log keeps notifications in storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ===== Cloudflare Turnstile =====
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_CA_BUNDLE=false

# ===== Backups =====
BACKUP_ARCHIVE_PASSWORD=
# Commented rather than blank: Spatie validates this list while building its
# config, and a present-but-empty value takes down every artisan command.
# BACKUP_NOTIFICATION_EMAIL=
BACKUP_PING_TOKEN=

# ===== Backblaze B2 (off-site backup tier) =====
# Not needed locally; the "b2" disk forces path-style requests.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-005
AWS_BUCKET=
AWS_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# ===== PayMongo (online payments) =====
PAYMONGO_BASE_URL=https://api.paymongo.com
PAYMONGO_MODE=sandbox
PAYMONGO_TEST_PUBLIC_KEY=
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_WEBHOOK_SECRET=
PAYMONGO_LIVE_PUBLIC_KEY=
PAYMONGO_LIVE_SECRET_KEY=
PAYMONGO_LIVE_WEBHOOK_SECRET=

# ===== PSGC (Philippine address selector) =====
PSGC_API_PREFIX=psgc
PSGC_CACHE=false
# PSGC_CACHE_STORE=database

# ===== Audit log =====
ACTIVITY_LOGGER_ENABLED=true

# ===== Vite (development only) =====
VITE_HMR_HOST=localhost
VITE_BACKEND_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=

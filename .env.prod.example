# -----------------------------------------------------------------------------
# Production environment template (safe to commit; holds no credentials).
# Copy to .env on the server and fill in every blank value.
# -----------------------------------------------------------------------------
# ===== Application =====
APP_NAME="Settlers Credit Cooperative"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
# Comma-separated keys still honoured while rotating APP_KEY.
# APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

SANCTUM_STATEFUL_DOMAINS=

PHP_CLI_SERVER_WORKERS=4

# ===== Authentication =====
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_TIMEOUT=10800

# ===== Database =====
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Directory holding the mysqldump binary. Required on Windows/Laragon for
# database-scope backups; leave unset on Linux/macOS where it is on PATH.
# DB_DUMP_BINARY_PATH=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin

# ===== Cache, queue, session, files =====
CACHE_STORE=database

QUEUE_CONNECTION=database
# Seconds a reserved job may run before it is released. Backups dump the whole
# database, so keep this comfortably above the longest backup.
DB_QUEUE_RETRY_AFTER=7200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local

# ===== Logging =====
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===== Mail =====
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# The only setting the smtp mailer reads for encryption, so this -- not
# MAIL_ENCRYPTION -- is what makes port 587 negotiate TLS. Drop it for port 465.
MAIL_SCHEME=tls
# Read by `php artisan app:test-email` only; the mailer ignores it.
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ===== Cloudflare Turnstile =====
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_CA_BUNDLE=false

# ===== Backups =====
# A lost password means the archives can never be decrypted again.
BACKUP_ARCHIVE_PASSWORD=
# Commented rather than blank: Spatie validates this list while building its
# config, and a present-but-empty value takes down every artisan command.
# BACKUP_NOTIFICATION_EMAIL=
BACKUP_PING_TOKEN=

# ===== Backblaze B2 (off-site backup tier) =====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-005
AWS_BUCKET=
AWS_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# ===== PayMongo (online payments) =====
PAYMONGO_BASE_URL=https://api.paymongo.com
# sandbox collects no real money; live charges real cards.
PAYMONGO_MODE=sandbox
PAYMONGO_TEST_PUBLIC_KEY=
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_WEBHOOK_SECRET=
PAYMONGO_LIVE_PUBLIC_KEY=
PAYMONGO_LIVE_SECRET_KEY=
PAYMONGO_LIVE_WEBHOOK_SECRET=

# ===== PSGC (Philippine address selector) =====
PSGC_API_PREFIX=psgc
PSGC_CACHE=false
# PSGC_CACHE_STORE=database

# ===== Audit log =====
ACTIVITY_LOGGER_ENABLED=true

# ===== Vite =====
# Only used at build time; the compiled bundle is what ships.
# VITE_HMR_HOST=localhost
# VITE_BACKEND_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=
